# Virtual environment - lives directly in the project root here
# (created via `python -m venv .`), NOT in a `venv/` subfolder, so we
# have to exclude its actual pieces by name.
Include/
Lib/
Scripts/
share/
pyvenv.cfg

__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

.env

*.db

# Optional: the Chroma vector cache is regenerated from real usage, so
# it doesn't strictly need to be version-controlled the way source code
# does. Uncomment if you'd rather not track it (leave commented if you
# want a specific cache state reproducible/shareable via git).
# chroma_data/

.DS_Store
.vscode/
.idea/